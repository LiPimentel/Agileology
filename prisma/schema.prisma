generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  draft
  published
}

enum BlockType {
  text
  image
  link
  video
  // Real, addable blocks now -- see blocks.ts's comment. The old
  // MapComponent/ContactFormComponent models below are unused going
  // forward (left in place rather than a destructive drop, same as
  // Page.menuOrder/menuVisible/showInMenu).
  map
  contactForm
}

enum BlogLayout {
  grid
  list
}

enum MessageStatus {
  new
  read
}

model Admin {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  adminId   String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([adminId])
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([adminId])
}

model Page {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  status        ContentStatus @default(draft)
  menuOrder     Int           @default(0)
  menuVisible   Boolean       @default(true)
  showInMenu    Boolean       @default(true)
  seoTitle      String?
  seoDescription String?
  isSystem      Boolean       @default(false) // e.g. contact page
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  publishedAt   DateTime?

  blocks        ContentBlock[]
  background    Background?
  mapComponent       MapComponent?
  contactFormComponent ContactFormComponent?
  versions      PageVersion[]
  contactSubmissions ContactFormSubmission[]
  visitLogs     VisitLog[]
  menuItems     MenuItem[]
}

// Replaces the old scheme of deriving the header nav purely from
// Page.menuOrder/menuVisible/showInMenu (still present on Page, just no
// longer read for nav -- left alone rather than risk a destructive column
// drop). This is a real, explicit menu: an admin adds/removes/reorders
// items directly, and an item can point at either an internal page or any
// URL (external site, or an internal path with no Page row, like /blog).
model MenuItem {
  id          String  @id @default(cuid())
  label       String
  linkType    String // "page" | "url"
  pageId      String?
  page        Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  externalUrl String? // used when linkType = "url"; can be a relative path or an absolute external URL
  newTab      Boolean @default(false)
  order       Int     @default(0)
  visible     Boolean @default(true)
  // "header" (default, the nav rendered by Nav.tsx) or "footer" (a flat
  // extra-links list rendered by Footer.tsx, e.g. static pages like Terms).
  // Footer items never nest (see saveMenuItems) -- only header items can
  // have children.
  location    String  @default("header")
  // Dropdown submenus: a top-level item's children. Only one level deep --
  // enforced in saveMenuItems, not here -- a child can't itself have
  // children. Deleting the parent deletes its submenu items with it
  // (an orphaned submenu pointing at a deleted parent isn't useful).
  parentId    String?
  parent      MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[] @relation("MenuItemChildren")

  @@index([pageId])
  @@index([parentId])
}

model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([pageId])
}

model Post {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  status        ContentStatus @default(draft)
  excerpt       String?
  featuredImage String?
  tags          String[]      @default([])
  seoTitle      String?
  seoDescription String?
  publishAt     DateTime?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  blocks   ContentBlock[]
  versions PostVersion[]
}

model PostVersion {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([postId])
}

model ContentBlock {
  id       String    @id @default(cuid())
  pageId   String?
  page     Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  postId   String?
  post     Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  type     BlockType
  content  Json
  // `position` identifies the section/row on the page -- multiple blocks
  // can share the same position, meaning they render side by side as
  // columns in one section. `columnIndex` orders them left-to-right within
  // that section, `columnWidth` is that column's width as a percentage.
  // Defaults (columnIndex 0, columnWidth 100) mean "not in a multi-column
  // section" -- every existing row and every post block (posts stay
  // single-column) is unaffected by this.
  position    Int       @default(0)
  columnIndex Int       @default(0)
  columnWidth Int       @default(100)
  // Order of this block within its column when a column stacks more than
  // one block (e.g. 2 texts + 1 image on one side of a 2-column section --
  // "los componentes... me estan limitando... quiero 2 textos y 1 imagen").
  // Default 0 means "only block in this column", so every existing row is
  // unaffected.
  blockOrder  Int       @default(0)

  // Per-SECTION background (pages only), duplicated identically across
  // every block sharing this `position` -- there's no separate Section
  // table, so this denormalizes cleanly onto the rows that already define
  // the section. Every save rewrites all of a page's blocks from scratch
  // (see upsertPageContent), so keeping these in sync across a section's
  // rows is automatic, not something that can drift over time.
  // opacity 0 = no visible overlay by default (section has no background
  // unless explicitly set).
  sectionBgImageUrl String?
  sectionBgColor    String  @default("#000000")
  sectionBgOpacity  Float   @default(0)
  // A real uploaded video (mp4/webm) as the section's background, shown
  // instead of sectionBgImageUrl when set -- the "Video" tab in the
  // section background picker.
  sectionBgVideoUrl String?
  // When set, the Color tab is a two-stop linear gradient (sectionBgColor
  // -> sectionBgGradientEnd) instead of a solid color -- matches the
  // client's own reference screenshot ("Selector de color" with a
  // gradient bar).
  sectionBgGradientEnd String?

  @@index([pageId])
  @@index([postId])
}

model Background {
  id             String  @id @default(cuid())
  pageId         String  @unique
  page           Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  imageUrl       String?
  overlayColor   String  @default("#3B0764")
  overlayOpacity Float   @default(0.5)
  // A real foreground graphic (logo, hero photo) shown IN the banner
  // alongside the title -- separate from imageUrl above, which is a
  // full-bleed CSS background-cover behind everything. "no veo como ahora
  // tirarle una imagen arriba como el logo que quiero que salga ahí
  // arriba" -- there was no way to place an actual image element there,
  // only the cover background.
  bannerImageUrl String?
  // Whether the title/background banner block renders at all, above the
  // page's own sections. Previously this was forced on every page with no
  // way to turn it off -- "eso no puede estar fijo como obligatorio en
  // cada página": a page whose design puts a video or a slideshow section
  // directly under the header has no use for a fixed purple title bar in
  // between. Defaults true so every existing page's current look is
  // unchanged; an admin opts a specific page out of it explicitly.
  showBanner     Boolean @default(true)
}

model BlogSettings {
  id         String     @id @default("singleton")
  layoutType BlogLayout @default(grid)
}

model ChatMessage {
  id          String        @id @default(cuid())
  visitorName  String?
  visitorEmail String?
  message     String
  status      MessageStatus @default(new)
  receivedAt  DateTime      @default(now())
}

model ContactFormSubmission {
  id          String        @id @default(cuid())
  pageId      String?
  page        Page?         @relation(fields: [pageId], references: [id], onDelete: SetNull)
  name        String
  email       String
  message     String
  status      MessageStatus @default(new)
  submittedAt DateTime      @default(now())
}

model MapComponent {
  id        String  @id @default(cuid())
  pageId    String  @unique
  page      Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  address   String
  latitude  Float?
  longitude Float?
}

model ContactFormComponent {
  id             String   @id @default(cuid())
  pageId         String   @unique
  page           Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  enabledFields  String[] @default(["name", "email", "message"])
}

model CommunicationSettings {
  id                          String @id @default("singleton")
  chatDestinationEmail        String
  contactFormDestinationEmail String
  // Configurable copy for the public chat widget (ChatWidget.tsx) --
  // previously hardcoded in Spanish, no way to change it without a code
  // change. Defaults match what was hardcoded, so existing sites don't
  // change behavior until an admin actually edits these.
  chatWidgetTitle          String @default("Un buen negocio")
  chatWidgetButtonLabel    String @default("💬 ¡Vamos a chatear!")
  chatWidgetPlaceholder    String @default("Escribe tu mensaje...")
  chatWidgetSuccessMessage String @default("Gracias, te responderemos pronto.")
}

model SiteSettings {
  id                    String  @id @default("singleton")
  siteTitle             String  @default("Agileology")
  tagline               String?
  logoUrl               String?
  faviconUrl            String?
  defaultMetaDescription String?
  footerText            String?
  facebookUrl           String?
  twitterUrl            String?
  linkedinUrl           String?
  instagramUrl          String?
  // Optional custom icon per network, uploaded from /admin/settings/site --
  // when unset, the footer falls back to a built-in Facebook/X/LinkedIn/
  // Instagram SVG icon instead of the old plain-text link.
  facebookIconUrl       String?
  twitterIconUrl        String?
  linkedinIconUrl       String?
  instagramIconUrl      String?
  phone                 String?
  whatsapp              String?
  cookieNoticeEnabled   Boolean @default(true)
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  altText   String?
  createdAt DateTime @default(now())
}

model VisitLog {
  id        String   @id @default(cuid())
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  path      String
  referrer  String?
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([pageId])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  detail     String?
  timestamp  DateTime @default(now())

  @@index([timestamp])
}
