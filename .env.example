# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (see prisma/schema.prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/agileology?schema=public"

# Random 32+ char secret used to sign session and CSRF cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# Backoffice session inactivity timeout, in minutes (RF-03)
SESSION_INACTIVITY_MINUTES=30

# Public site URL, used for sitemap/RSS/absolute links and CORS-style checks
NEXT_PUBLIC_SITE_URL="https://agileologywave.com"

# Gmail SMTP for chat/contact email delivery (RF-27, RF-33).
# Use a Gmail "App Password", not the account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="scrummetme@gmail.com"
SMTP_PASS="replace-with-gmail-app-password"
SMTP_FROM="Agileology Wave <scrummetme@gmail.com>"

# Seed script (npx prisma db seed) creates the first admin with these
# credentials. Change the password after first login.
ADMIN_SEED_NAME="Lissette Pimentel"
ADMIN_SEED_EMAIL="scrummetme@gmail.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"

# Default destination emails seeded into CommunicationSettings on first run
CHAT_DESTINATION_EMAIL_DEFAULT="scrummetme@gmail.com"
CONTACT_DESTINATION_EMAIL_DEFAULT="scrummetme@gmail.com"
